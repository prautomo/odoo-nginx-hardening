# Copy to /etc/odoo-alert.env and chmod 600. Never commit the real token.
# Bot token: talk to @BotFather. Chat ID: add the bot to a group, send
# "/start@your_bot" there, then read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TG_TOKEN=123456789:replace-me
TG_CHAT=-1000000000000

HOST_LABEL="Odoo production"
ALERT_TZ=Asia/Jakarta

# Thresholds
DISK_MAX=80
MEM_MIN_MB=1024
SWAP_MAX_MB=1024
LOAD_MAX=3.0          # 15-minute load average; ~75% of 4 cores

# HTTPS certificate served by local nginx (leave empty to skip)
CERT_NAME=odoo.example.com

# Odoo logs: Docker Compose ...
ODOO_COMPOSE=/srv/odoo/docker-compose.yml
ODOO_SERVICE=odoo
# ... or a systemd service
# ODOO_UNIT=odoo
ODOO_ERR_MAX=20

# Containers that must be running (space separated, optional)
CONTAINERS="odoo-odoo-1 odoo-db-1"

# A second server to watch from the outside (optional)
PEER_NAME="Backup server"
PEER_URL=https://backup.example.com/

# Backup status files (optional), "name:file:hour" where hour is the local
# hour after which today's date must appear in the file.
# BACKUP_CHECKS="db-dump:/opt/backup/LAST_RUN:3 offsite:/opt/backup/LAST_OFFSITE:5"
